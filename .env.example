# ============================================================
# Sandmosquito Water Billing Environment Configuration
# ============================================================

# 1. Google Apps Script Web App Deployment URL (Opsi Produksi Cloud)
# Jika sudah deploy ke Google Apps Script, masukkan URL di bawah:
VITE_GAS_API_URL=

# 2. Local SQLite Server URL (Opsi Backend Lokal SQLite)
# Aktif saat menjalankan "bun run server" (Port default: 3001)
VITE_SQLITE_API_URL=http://localhost:3001

# 3. Force Mock Mode (true / false)
# Set "true" jika ingin mengabaikan server dan hanya menggunakan storage simulasi browser
VITE_ENABLE_MOCK_MODE=false
