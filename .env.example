# Sandmosquito Water Billing Configuration
# Google Apps Script Web App URL (optional cloud alternative)
VITE_GAS_API_URL=

# Local SQLite Backend Server (default local alternative)
VITE_SQLITE_API_URL=http://localhost:3001

# Supabase Cloud Database (default when local/GAS is not configured)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Force mock mode (overrides all backends)
VITE_ENABLE_MOCK_MODE=false
