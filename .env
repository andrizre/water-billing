# Sandmosquito Water Billing Configuration

# Active Database Backend Selection
# Options: supabase | sqlite | gas | mock
# Default: supabase
VITE_ACTIVE_BACKEND=supabase

# 1. Supabase Cloud Database (Default)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Local SQLite Backend Server (Requires: npm run server / bun run server/server.ts)
VITE_SQLITE_API_URL=http://localhost:3001

# 3. Google Apps Script Web App URL (Optional Cloud Alternative)
VITE_GAS_API_URL=
